{
  "expo": {
    "name": "Crypto Pilot",
    "slug": "crypto-pilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cryptopilot.personal",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.cryptopilot.personal"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Crypto Pilot needs your photos so you can choose a chart screenshot for the AI to analyse.",
          "cameraPermission": "Crypto Pilot uses the camera so you can photograph a chart for the AI to analyse."
        }
      ]
    ],
    "scheme": "cryptopilot",
    "extra": {
      "phantomAppUrl": "https://expo.dev"
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
