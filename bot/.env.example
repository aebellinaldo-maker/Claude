# Copy this file to .env and fill in what you have. Empty values are ignored.

# --- AI decisions (https://console.anthropic.com → API Keys; needs prepaid credits) ---
# Without a key the bot still works, using its built-in rules.
ANTHROPIC_API_KEY=

# --- Solana connection ---
# The public endpoint works but is slow and rate limited. A free Helius key is recommended:
# https://www.helius.dev → sign up (free plan) → copy the mainnet RPC URL.
RPC_URL=https://api.mainnet-beta.solana.com

# Your Phantom wallet address. Withdrawals from the bot can ONLY go to this address.
# If left empty, the first Phantom wallet you connect in the app is registered (and then locked).
OWNER_WALLET=

# --- Server ---
PORT=8787
# 0.0.0.0 = reachable from your phone on the same Wi-Fi. The setup script sets 127.0.0.1
# because Caddy (HTTPS) sits in front of the bot on a cloud server.
HOST=0.0.0.0
# Leave empty to auto-generate one into data/api-token.txt on first start.
API_TOKEN=

# --- Optional: buy with card / PayPal / Apple Pay with your wallet address pre-filled ---
# Without these keys the app opens MoonPay's website and copies your address for you.
# MoonPay: https://dashboard.moonpay.com  (pk_live_… and sk_live_…)
MOONPAY_PUBLISHABLE_KEY=
MOONPAY_SECRET_KEY=
# Transak: https://dashboard.transak.com
TRANSAK_API_KEY=

# --- Optional: Jupiter API key for higher rate limits (https://portal.jup.ag) ---
JUPITER_API_KEY=

# Where state, the bot wallet and the API token are stored. BACK UP data/bot-wallet.json!
DATA_DIR=./data
